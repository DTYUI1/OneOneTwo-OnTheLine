#!/bin/sh
# Копия по кнопке администратора (C-07): cron раз в минуту забирает один запрос из таблицы
# backups и выполняет тот же backup-once, что и ночью. Браузер команд на сервере не выполняет.
set -eu

# Копия, «идущая» дольше 6 часов, прервана перезапуском: иначе новую не запросить.
psql -X -q -t -A -v ON_ERROR_STOP=1 >/dev/null <<'SQL'
UPDATE backups
SET status = 'failed', finished_at = now(), error = 'Копия прервана: не завершилась за 6 часов.'
WHERE status = 'running' AND started_at < now() - interval '6 hours';
SQL
id=$(psql -X -q -t -A -v ON_ERROR_STOP=1 <<'SQL'
UPDATE backups SET status = 'running', started_at = now()
WHERE id = (
  SELECT id FROM backups WHERE status = 'pending'
  ORDER BY requested_at LIMIT 1 FOR UPDATE SKIP LOCKED
)
RETURNING id;
SQL
)
[ -n "$id" ] || exit 0
BACKUP_ID=$id exec /usr/local/bin/backup-once
