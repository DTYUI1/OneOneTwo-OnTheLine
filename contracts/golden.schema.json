          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "client_event_id": {
                "type": "string",
                "format": "uuid"
              },
              "client_ts": {
                "type": "string",
                "format": "date-time"
              },
              "type": {
                "type": "string",
                "enum": [
                  "field_change"
                ]
              },
              "payload": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "field": {
                        "type": "string",
