                    "type": "string",
                    "pattern": "^[0-9]{3}$"
                  }
                },
                "required": [
                  "call_id",
                  "phone_ext"
                ]
              },
              "server_ts": {
                "type": "string",
                "format": "date-time"
              },
              "clock_offset_ms": {
                "type": "number"
              }
            },
            "required": [
              "client_event_id",
              "client_ts",
              "type",
              "payload",
              "server_ts",
              "clock_offset_ms"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "client_event_id": {
                "type": "string",
                "format": "uuid"
              },
              "client_ts": {
