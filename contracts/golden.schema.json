            "type": "object",
            "additionalProperties": false,
            "properties": {
              "client_event_id": {
                "type": "string",
                "format": "uuid"
              },
              "client_ts": {
                "type": "string",
                "format": "date-time"
              },
              "type": {
                "type": "string",
                "enum": [
                  "call_dial"
                ]
              },
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "call_id": {
                    "type": "string",
                    "format": "uuid"
                  },
