                    "required": [
                      "field",
                      "value"
                    ]
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "field": {
                        "type": "string",
                        "enum": [
                          "address"
                        ]
                      },
                      "value": {
                        "type": "object",
                        "additionalProperties": false,
                        "description": "Адрес, введённый обучаемым вручную; исходный адрес карточки — source.address. Не используется АРМ ДДС с 08.10 (DT-14): адрес проверяется в комментариях; поле остаётся для старых событий.",
                        "properties": {
                          "city": {
                            "type": "string",
                            "maxLength": 200
                          },
                          "street": {
                            "type": "string",
                            "maxLength": 200
                          },
                          "house": {
                            "type": "string",
                            "maxLength": 200
                          },
                          "building": {
                            "type": "string",
                            "maxLength": 200
                          },
                          "apartment": {
                            "type": "string",
                            "maxLength": 200
                          }
                        },
                        "required": [
                          "city",
                          "street",
                          "house",
                          "building",
                          "apartment"
                        ]
                      }
                    },
                    "required": [
                      "field",
                      "value"
                    ]
                  }
                ]
              },
              "server_ts": {
                "type": "string",
                "format": "date-time"
              },
              "clock_offset_ms": {
                "type": "number"
              }
            },
            "required": [
              "client_event_id",
              "client_ts",
              "type",
              "payload",
              "server_ts",
              "clock_offset_ms"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "client_event_id": {
                "type": "string",
                "format": "uuid"
              },
              "client_ts": {
                "type": "string",
                "format": "date-time"
              },
              "type": {
                "type": "string",
                "enum": [
                  "status_change"
                ]
              },
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "state": {
                    "type": "string",
                    "enum": [
                      "accepted",
                      "rejected",
                      "responding",
                      "arrived",
                      "working",
                      "refused",
                      "completed"
                    ]
                  },
                  "comment": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  }
                },
                "required": [
                  "state",
                  "comment"
                ]
              },
              "server_ts": {
                "type": "string",
                "format": "date-time"
              },
              "clock_offset_ms": {
                "type": "number"
              }
            },
            "required": [
              "client_event_id",
              "client_ts",
              "type",
              "payload",
