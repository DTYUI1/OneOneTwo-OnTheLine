{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arm112.local/contracts/current.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "service_number": {
      "type": "string",
      "maxLength": 64
    },
    "comment": {
      "type": "string",
      "maxLength": 4000
    },
    "address": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "description": "Адрес, введённый обучаемым вручную; исходный адрес карточки — source.address.",
          "properties": {
            "city": {
              "type": "string",
              "maxLength": 200
            },
            "street": {
              "type": "string",
              "maxLength": 200
            },
            "house": {
              "type": "string",
              "maxLength": 200
            },
            "building": {
              "type": "string",
              "maxLength": 200
            },
            "apartment": {
              "type": "string",
              "maxLength": 200
            }
          },
          "required": [
            "city",
            "street",
            "house",
            "building",
            "apartment"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "service_number",
    "comment"
  ]
}
