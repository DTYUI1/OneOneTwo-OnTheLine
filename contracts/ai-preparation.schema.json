{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arm112.local/contracts/ai-preparation.schema.json",
  "$defs": {
    "AISelection": {
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "format": "uuid",
          "title": "Request Id",
          "type": "string"
        },
        "cards_per_participant": {
          "default": 1,
          "maximum": 4,
          "minimum": 1,
          "title": "Cards Per Participant",
          "type": "integer"
        },
        "generation_policy": {
          "type": "string",
          "enum": [
            "after_lessons",
            "now"
          ],
          "default": "after_lessons",
          "description": "Генерация во время идущего занятия: после занятия (по умолчанию) или сейчас."
        },
        "categories": {
          "title": "Categories",
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "traffic",
              "fire",
              "gas",
              "medicine",
              "utilities",
              "lift",
              "public_order",
              "animals",
              "other"
            ]
          }
        }
      },
      "required": [
        "request_id"
      ],
      "title": "AISelection",
      "type": "object"
    },
    "AIParticipantRecommendation": {
      "additionalProperties": false,
      "properties": {
        "user_id": {
          "format": "uuid",
          "title": "User Id",
          "type": "string"
        },
        "service_id": {
          "title": "Service Id",
          "type": "string"
        },
        "level": {
          "title": "Level",
          "type": "integer"
        },
        "weight": {
          "title": "Weight",
          "type": "integer"
        },
        "based_on_attempts": {
          "title": "Based On Attempts",
          "type": "integer"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        }
      },
      "required": [
        "user_id",
        "service_id",
        "level",
        "weight",
        "based_on_attempts",
        "explanation"
      ],
      "title": "AIParticipantRecommendation",
      "type": "object"
    },
    "AIPreparation": {
      "additionalProperties": false,
      "properties": {
        "job_id": {
          "format": "uuid",
          "title": "Job Id",
          "type": "string"
        },
        "state": {
          "enum": [
            "waiting",
            "queued",
            "generating",
            "ready",
            "failed"
          ],
          "title": "State",
          "type": "string"
        },
        "cards_per_participant": {
          "title": "Cards Per Participant",
          "type": "integer"
        },
        "completed": {
          "title": "Completed",
          "type": "integer"
        },
        "total": {
          "title": "Total",
          "type": "integer"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "recommendations": {
          "items": {
            "$ref": "#/$defs/AIParticipantRecommendation"
          },
          "title": "Recommendations",
          "type": "array"
        }
      },
      "required": [
        "job_id",
        "state",
        "cards_per_participant",
        "completed",
        "total",
        "warnings",
        "recommendations"
      ],
      "title": "AIPreparation",
      "type": "object"
    }
  },
  "$ref": "#/$defs/AIPreparation"
}
