{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arm112.local/contracts/scenario-narrative.schema.json",
  "title": "ScenarioNarrative",
  "description": "LLM-generated fields layered over a deterministic training scenario.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "caller_name",
    "description",
    "tags"
  ],
  "properties": {
    "caller_name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "minLength": 80,
      "maxLength": 700
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 80
      }
    }
  }
}
