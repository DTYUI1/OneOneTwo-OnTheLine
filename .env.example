# Только синтетические локальные данные. Перед работой в сети смените пароли.
COMPOSE_FILE=deploy/docker-compose.yml
POSTGRES_DB=arm112
POSTGRES_USER=arm112
POSTGRES_PASSWORD=local-dev-only
DATABASE_URL=postgresql+asyncpg://arm112:local-dev-only@db:5432/arm112
DATABASE_URL_TEST=postgresql+asyncpg://arm112:local-dev-only@localhost:5432/arm112_test
API_MODE=mock
# Для API_MODE=database: постоянный случайный секрет длиной не менее 32 байт.
JWT_SECRET=
SESSION_TTL_SECONDS=28800
DEMO_PASSWORD=demo-local
AI_PROVIDER=off
LLM_MODEL_FILE=../models/qwen3-4b-instruct-2507-q4_k_m.gguf
BACKUP_DIR=../backups
LLM_BASE_URL=http://llm:8080/v1
LLM_MODEL=qwen3-4b-2507-q4km
LLM_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=300
# ИИ-судья комментария на CPU (C-06); по таймауту оценка остаётся partial.
JUDGE_TIMEOUT_SECONDS=120
AUDIO_DIR=./tmp/audio
# Учебные доклады бригад (C-04): неизменяемые файлы из репозитория.
INFORMATION_AUDIO_DIR=./data/voices
EMBEDDINGS_PROVIDER=off
TTS_PROVIDER=prerendered
STT_PROVIDER=off
COOKIE_SECURE=true
WORKER_POLL_INTERVAL_SECONDS=0.5
WORKER_LEASE_SECONDS=120
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_BASE_SECONDS=2
WORKER_BATCH_SIZE=23
